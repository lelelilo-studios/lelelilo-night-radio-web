   "t0": 0.0,
   "t1": 3.0,
   "label": "Mo",
   "spk": 0,
   "text": "Night Radio, you're on the air! This is Mo. Who's calling?...",
   "kind": "turn"
  },
  {
   "t0": 3.0,
   "t1": 6.0,
   "label": "Bram",
   "spk": 1,
   "text": "It's Bram again, from the lighthouse.",
   "kind": "turn"
  },
  {
   "t0": 6.0,
   "t1": 8.0,
   "label": "Mo",
   "spk": 0,
   "text": "Bram! Good to hear your voice from the north...",
   "kind": "turn"
  },
  {
   "t0": 8.0,
   "t1": 16.0,
   "label": "Bram",
   "spk": 1,
   "text": "The lamp's behaving tonight, thank you, but I can't sleep. What's on after 1:00?",
   "kind": "turn"
  },
  {
   "t0": 16.0,
   "t1": 18.0,
   "label": "Mo",
   "spk": 0,
   "text": "After one in the morning it's Lighthouse Letters, with Pip...",
   "kind": "turn"
  },
  {
   "t0": 18.0,
   "t1": 22.0,
   "label": "Bram",
   "spk": 1,
   "text": "Could you play that music box lullaby again?",
   "kind": "turn"
  },
  {
   "t0": 22.0,
   "t1": 32.0,
   "label": "Bram",
   "spk": 1,
   "text": "For the seals sleeping on the ferry ramp. And send a dedication to Sophia, the night nurse. Tell her the whole cape is grateful.",
   "kind": "turn"
  },
  {
   "t0": 32.0,
   "t1": 34.0,
   "label": "Mo",
   "spk": 0,
   "text": "There it goes, Bram, the music-box lullaby...",
   "kind": "turn"
  },
  {
   "t0": 34.0,
   "t1": 38.0,
   "label": "Bram",
   "spk": 1,
   "text": "Right. Good night, Moe. Keep the music coming.",
   "kind": "turn"
  },
  {
   "t0": 38.0,
   "t1": 41.616,
   "label": "Mo",
   "spk": 0,
   "text": "Goodnight, Bram, sleep well out there on the cape...",
   "kind": "turn"
  }
 ],
